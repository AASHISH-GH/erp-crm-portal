# ---------------------------------------------------------------------------
# Client environment. Copy to .env for local development.
#
# Vite inlines VITE_* variables at BUILD time, not runtime — changing this on the
# host after deploying requires a rebuild, not just a restart.
# ---------------------------------------------------------------------------

# Leave EMPTY for local development: vite.config.ts proxies /api to localhost:4000,
# which avoids CORS entirely.
#
# For a deployed build, set the full origin of the API (no trailing slash):
#   VITE_API_URL=https://erp-crm-api.onrender.com
VITE_API_URL=
