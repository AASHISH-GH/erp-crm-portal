    {
      "name": "Role enforcement",
      "description": "Run 'Auth → Login (Accounts)' first, then these. Accounts is read-only, so both writes must be refused with 403.",
      "item": [
        {
          "name": "Accounts cannot create a customer (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('forbidden for ACCOUNTS', () => pm.response.to.have.status(403));",
                  "pm.test('explains the rule', () => pm.expect(pm.response.json().error.message).to.include('Allowed roles'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Should Not Be Created\",\n  \"mobile\": \"9876512345\"\n}"
            },
            "url": { "raw": "{{apiUrl}}/customers", "host": ["{{apiUrl}}"], "path": ["customers"] }
          }
        },
        {
          "name": "Accounts cannot move stock (403)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 10,\n  \"type\": \"IN\",\n  \"reason\": \"Should be refused\"\n}"
            },
            "url": {
              "raw": "{{apiUrl}}/stock/movements",
              "host": ["{{apiUrl}}"],
              "path": ["stock", "movements"]
            }
          }
        },
        {
          "name": "No token supplied (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{apiUrl}}/customers", "host": ["{{apiUrl}}"], "path": ["customers"] }
          }
        }
      ]
    }
