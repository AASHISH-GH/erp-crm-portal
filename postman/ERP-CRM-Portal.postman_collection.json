              "mode": "raw",
              "raw": "{\n  \"reason\": \"Customer cancelled before dispatch\"\n}"
            },
            "url": {
              "raw": "{{apiUrl}}/challans/{{challanId}}/cancel",
              "host": ["{{apiUrl}}"],
              "path": ["challans", "{{challanId}}", "cancel"]
            }
          }
