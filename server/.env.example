# ---------------------------------------------------------------------------
# Server environment. Copy to .env and fill in real values.
# .env is git-ignored; never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# PostgreSQL connection string.
# Local:  postgresql://postgres:postgres@localhost:5432/erp_crm?schema=public
# Neon:   postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erp_crm?schema=public

# Must be at least 16 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Comma-separated allowed origins, or * for any (development only).
CORS_ORIGIN=http://localhost:5173

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=500

# Password given to every seeded demo user.
SEED_DEFAULT_PASSWORD=Password@123
